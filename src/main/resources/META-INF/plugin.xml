<idea-plugin>
    <id>jp.titze.intellij.helix</id>
    <name>Helix Keymap</name>
    <vendor url="https://titze.jp">Thorsten Titze</vendor>

    <description><![CDATA[
        A modal editing plugin for IntelliJ IDEA implementing the Helix selection-first paradigm.
        Features:
        <ul>
            <li>Per-editor modal state: Normal, Insert, Select modes with block/line cursor integration.</li>
            <li>Selection-first motions: f, t, F, T (find/till char across lines, including Enter), w, b, e, ge, x, %, h, j, k, l, gh, gl, gg.</li>
            <li>Direct selection actions: d (delete), c (change), y (yank), p / P (paste), ;, Alt+;, ,.</li>
            <li>Surround functionality (Match mode): ms (add surround), mr (replace surround), md (delete surround), mm (match bracket jump).</li>
            <li>Full native multi-caret support.</li>
            <li>Deep IntelliJ IDE ActionManager integration:
                <ul>
                    <li>g menu: gd, gy, gr, gh, gl, ge, gg</li>
                    <li>space menu: space+f (SearchEverywhere), space+b (RecentFiles), space+s (Structure), space+S (Symbols), space+a (Intentions/Quick-fixes), space+d (Diagnostics), space+r (Rename)</li>
                    <li>[d / ]d: Error jumps</li>
                    <li>Alt+o / Alt+i: Structural AST selection expansion and shrinking</li>
                    <li>Alt+n: Multi-caret select next occurrence</li>
                    <li>C / Alt+C: Multi-caret copy selection to next / previous line</li>
                    <li>Alt+,: Remove primary selection</li>
                    <li>( / ): Rotate main selection backward / forward</li>
                    <li>Alt+s: Split selection on newlines</li>
                    <li>Alt+;: Flip selection cursor and anchor</li>
                    <li>Ctrl+c: Toggle line comment</li>
                    <li>Ctrl+f / Ctrl+b (PageDown / PageUp): Page down / up</li>
                    <li>Ctrl+d / Ctrl+u: Half page down / up</li>
                    <li>Ctrl+a / Ctrl+x: Increment / decrement integer under cursor or selection</li>
                    <li>K: Quick documentation hover</li>
                    <li>=: Reformat code</li>
                    <li>u / U: Native undo / redo</li>
                </ul>
            </li>
            <li>Lightweight Helix command bar: :w, :q, :wq, :wa, :qa.</li>
            <li>Status bar mode indicator showing active mode and pending key chords.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="jp.titze.intellij.helix.editor.HelixEditorListener"/>
        <statusBarWidgetFactory implementation="jp.titze.intellij.helix.ui.HelixStatusBarWidgetFactory"
                                id="jp.titze.intellij.helix.status"/>
        <applicationService serviceImplementation="jp.titze.intellij.helix.settings.HelixSettings"/>
        <applicationConfigurable parentId="tools"
                                 instance="jp.titze.intellij.helix.settings.HelixConfigurable"
                                 id="jp.titze.intellij.helix.settings"
                                 displayName="Helix Keymap"/>
    </extensions>

    <projectListeners>
        <listener class="jp.titze.intellij.helix.editor.HelixFileEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <actions>
        <action id="jp.titze.intellij.helix.escape"
                class="jp.titze.intellij.helix.editor.HelixEscapeAction"
                text="Helix Escape"
                description="Return to Normal mode">
            <keyboard-shortcut keymap="$default" first-keystroke="ESCAPE"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="ESCAPE"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="ESCAPE"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control OPEN_BRACKET"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control OPEN_BRACKET"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control OPEN_BRACKET"/>
        </action>

        <action id="jp.titze.intellij.helix.expandSelection"
                class="jp.titze.intellij.helix.editor.HelixExpandSelectionAction"
                text="Helix Expand Selection"
                description="Expand structural selection (Tree-sitter / PSI)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt O"/>
        </action>

        <action id="jp.titze.intellij.helix.shrinkSelection"
                class="jp.titze.intellij.helix.editor.HelixShrinkSelectionAction"
                text="Helix Shrink Selection"
                description="Shrink structural selection (Tree-sitter / PSI)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt I"/>
        </action>

        <action id="jp.titze.intellij.helix.selectPrevSibling"
                class="jp.titze.intellij.helix.editor.HelixSelectPrevSiblingAction"
                text="Helix Select Previous Sibling"
                description="Select previous sibling AST element">
            <keyboard-shortcut keymap="$default" first-keystroke="alt P"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt P"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt P"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt LEFT"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt LEFT"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt LEFT"/>
        </action>

        <action id="jp.titze.intellij.helix.selectNextSibling"
                class="jp.titze.intellij.helix.editor.HelixSelectNextSiblingAction"
                text="Helix Select Next Sibling"
                description="Select next sibling AST element">
            <keyboard-shortcut keymap="$default" first-keystroke="alt N"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt N"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt N"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt RIGHT"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt RIGHT"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt RIGHT"/>
        </action>

        <action id="jp.titze.intellij.helix.moveParentNodeStart"
                class="jp.titze.intellij.helix.editor.HelixMoveParentNodeStartAction"
                text="Helix Move to Parent Node Start"
                description="Move caret or expand selection to start of parent AST node">
            <keyboard-shortcut keymap="$default" first-keystroke="alt B"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt B"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt B"/>
        </action>

        <action id="jp.titze.intellij.helix.moveParentNodeEnd"
                class="jp.titze.intellij.helix.editor.HelixMoveParentNodeEndAction"
                text="Helix Move to Parent Node End"
                description="Move caret or expand selection to end of parent AST node">
            <keyboard-shortcut keymap="$default" first-keystroke="alt E"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt E"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt E"/>
        </action>

        <action id="jp.titze.intellij.helix.selectAllSiblings"
                class="jp.titze.intellij.helix.editor.HelixSelectAllSiblingsAction"
                text="Helix Select All Siblings"
                description="Select all sibling AST elements">
            <keyboard-shortcut keymap="$default" first-keystroke="alt A"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt A"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt A"/>
        </action>

        <action id="jp.titze.intellij.helix.selectAllChildren"
                class="jp.titze.intellij.helix.editor.HelixSelectAllChildrenAction"
                text="Helix Select All Children"
                description="Select all direct children nodes">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift I"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift I"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt shift I"/>
        </action>

        <action id="jp.titze.intellij.helix.selectNextOccurrence"
                class="jp.titze.intellij.helix.editor.HelixSelectNextOccurrenceAction"
                text="Helix Select Next Occurrence"
                description="Select next occurrence of current selection">
        </action>

        <action id="jp.titze.intellij.helix.copySelectionOnNextLine"
                class="jp.titze.intellij.helix.editor.HelixCopySelectionOnNextLineAction"
                text="Helix Copy Selection on Next Line"
                description="Copy selection to next line (add caret below)">
        </action>

        <action id="jp.titze.intellij.helix.copySelectionOnPrevLine"
                class="jp.titze.intellij.helix.editor.HelixCopySelectionOnPrevLineAction"
                text="Helix Copy Selection on Previous Line"
                description="Copy selection to previous line (add caret above)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift C"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift C"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt shift C"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt C"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt C"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt C"/>
        </action>

        <action id="jp.titze.intellij.helix.removePrimarySelection"
                class="jp.titze.intellij.helix.editor.HelixRemovePrimarySelectionAction"
                text="Helix Remove Primary Selection"
                description="Remove primary selection">
            <keyboard-shortcut keymap="$default" first-keystroke="alt COMMA"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt COMMA"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt COMMA"/>
        </action>

        <action id="jp.titze.intellij.helix.rotateSelectionsForward"
                class="jp.titze.intellij.helix.editor.HelixRotateSelectionsForwardAction"
                text="Helix Rotate Selections Forward"
                description="Rotate main selection forward">
        </action>

        <action id="jp.titze.intellij.helix.rotateSelectionsBackward"
                class="jp.titze.intellij.helix.editor.HelixRotateSelectionsBackwardAction"
                text="Helix Rotate Selections Backward"
                description="Rotate main selection backward">
        </action>

        <action id="jp.titze.intellij.helix.splitSelectionOnNewline"
                class="jp.titze.intellij.helix.editor.HelixSplitSelectionOnNewlineAction"
                text="Helix Split Selection on Newlines"
                description="Split selection on newlines">
            <keyboard-shortcut keymap="$default" first-keystroke="alt S"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt S"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt S"/>
        </action>

        <action id="jp.titze.intellij.helix.flipSelection"
                class="jp.titze.intellij.helix.editor.HelixFlipSelectionAction"
                text="Helix Flip Selection Anchor and Cursor"
                description="Flip selection anchor and cursor">
            <keyboard-shortcut keymap="$default" first-keystroke="alt SEMICOLON"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt SEMICOLON"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt SEMICOLON"/>
        </action>

        <action id="jp.titze.intellij.helix.commentLine"
                class="jp.titze.intellij.helix.editor.HelixCommentLineAction"
                text="Helix Comment Line"
                description="Toggle line comment">
            <keyboard-shortcut keymap="$default" first-keystroke="control C"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control C"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control C"/>
        </action>

        <action id="jp.titze.intellij.helix.pageDown"
                class="jp.titze.intellij.helix.editor.HelixPageDownAction"
                text="Helix Page Down"
                description="Scroll and move page down">
            <keyboard-shortcut keymap="$default" first-keystroke="control F"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control F"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control F"/>
            <keyboard-shortcut keymap="$default" first-keystroke="PAGE_DOWN"/>
        </action>

        <action id="jp.titze.intellij.helix.pageUp"
                class="jp.titze.intellij.helix.editor.HelixPageUpAction"
                text="Helix Page Up"
                description="Scroll and move page up">
            <keyboard-shortcut keymap="$default" first-keystroke="control B"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control B"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control B"/>
            <keyboard-shortcut keymap="$default" first-keystroke="PAGE_UP"/>
        </action>

        <action id="jp.titze.intellij.helix.halfPageDown"
                class="jp.titze.intellij.helix.editor.HelixHalfPageDownAction"
                text="Helix Half Page Down"
                description="Scroll and move half page down">
            <keyboard-shortcut keymap="$default" first-keystroke="control D"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control D"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control D"/>
        </action>

        <action id="jp.titze.intellij.helix.halfPageUp"
                class="jp.titze.intellij.helix.editor.HelixHalfPageUpAction"
                text="Helix Half Page Up"
                description="Scroll and move half page up">
            <keyboard-shortcut keymap="$default" first-keystroke="control U"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control U"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control U"/>
        </action>

        <action id="jp.titze.intellij.helix.jumpBackward"
                class="jp.titze.intellij.helix.editor.HelixJumpBackwardAction"
                text="Helix Jump Backward"
                description="Jump to previous location in jumplist">
            <keyboard-shortcut keymap="$default" first-keystroke="control O"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control O"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control O"/>
        </action>

        <action id="jp.titze.intellij.helix.jumpForward"
                class="jp.titze.intellij.helix.editor.HelixJumpForwardAction"
                text="Helix Jump Forward"
                description="Jump to next location in jumplist">
            <keyboard-shortcut keymap="$default" first-keystroke="control I"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control I"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control I"/>
        </action>

        <action id="jp.titze.intellij.helix.saveJump"
                class="jp.titze.intellij.helix.editor.HelixSaveJumpAction"
                text="Helix Save Jump / Undo Checkpoint"
                description="Save current selection to jumplist (Normal) or commit undo checkpoint (Insert)">
            <keyboard-shortcut keymap="$default" first-keystroke="control S"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control S"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control S"/>
        </action>

        <action id="jp.titze.intellij.helix.undoCheckpoint"
                class="jp.titze.intellij.helix.editor.HelixUndoCheckpointAction"
                text="Helix Commit Undo Checkpoint"
                description="Commit an undo checkpoint to break typing history">
        </action>

        <action id="jp.titze.intellij.helix.jumplistPicker"
                class="jp.titze.intellij.helix.editor.HelixJumplistPickerAction"
                text="Helix Jumplist Picker"
                description="Open jumplist picker popup">
        </action>

        <action id="jp.titze.intellij.helix.registersPicker"
                class="jp.titze.intellij.helix.editor.HelixRegistersPickerAction"
                text="Helix Registers Picker"
                description="Open registers picker popup">
        </action>

        <action id="jp.titze.intellij.helix.switchCase"
                class="jp.titze.intellij.helix.editor.HelixSwitchCaseAction"
                text="Helix Switch Case"
                description="Switch case of selected text (~)">
        </action>

        <action id="jp.titze.intellij.helix.switchToLowercase"
                class="jp.titze.intellij.helix.editor.HelixSwitchToLowercaseAction"
                text="Helix Switch to Lowercase"
                description="Set selected text to lower case (`)">
        </action>

        <action id="jp.titze.intellij.helix.switchToUppercase"
                class="jp.titze.intellij.helix.editor.HelixSwitchToUppercaseAction"
                text="Helix Switch to Uppercase"
                description="Set selected text to upper case (Alt+`)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt BACK_QUOTE"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt BACK_QUOTE"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt BACK_QUOTE"/>
        </action>

        <action id="jp.titze.intellij.helix.increment"
                class="jp.titze.intellij.helix.editor.HelixIncrementAction"
                text="Helix Increment"
                description="Increment integer under cursor or within selection (Ctrl+a)">
            <keyboard-shortcut keymap="$default" first-keystroke="control A"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control A"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control A"/>
        </action>

        <action id="jp.titze.intellij.helix.decrement"
                class="jp.titze.intellij.helix.editor.HelixDecrementAction"
                text="Helix Decrement"
                description="Decrement integer under cursor or within selection (Ctrl+x)">
            <keyboard-shortcut keymap="$default" first-keystroke="control X"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control X"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control X"/>
        </action>

        <action id="jp.titze.intellij.helix.windowChord"
                class="jp.titze.intellij.helix.editor.HelixWindowChordAction"
                text="Helix Window and Split Menu"
                description="Window and split management (Ctrl+w)">
            <keyboard-shortcut keymap="$default" first-keystroke="control W"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control W"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control W"/>
        </action>

        <action id="jp.titze.intellij.helix.trimSelections"
                class="jp.titze.intellij.helix.editor.HelixTrimSelectionsAction"
                text="Helix Trim Selections"
                description="Trim whitespace from selections (_)">
        </action>

        <action id="jp.titze.intellij.helix.alignSelections"
                class="jp.titze.intellij.helix.editor.HelixAlignSelectionsAction"
                text="Helix Align Selections"
                description="Align selections by padding with whitespace (&amp;)">
        </action>

        <action id="jp.titze.intellij.helix.keepSelections"
                class="jp.titze.intellij.helix.editor.HelixKeepSelectionsAction"
                text="Helix Keep Selections"
                description="Filter selections by regex, keeping matching (Alt+k)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt K"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt K"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt K"/>
        </action>

        <action id="jp.titze.intellij.helix.removeSelections"
                class="jp.titze.intellij.helix.editor.HelixRemoveSelectionsAction"
                text="Helix Remove Selections"
                description="Filter selections by regex, removing matching (Alt+K)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift K"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift K"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt shift K"/>
        </action>

        <action id="jp.titze.intellij.helix.ensureSelectionsForward"
                class="jp.titze.intellij.helix.editor.HelixEnsureSelectionsForwardAction"
                text="Helix Ensure Selections Forward"
                description="Flip backward selections forward (Alt+:)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift SEMICOLON"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift SEMICOLON"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt shift SEMICOLON"/>
        </action>

        <action id="jp.titze.intellij.helix.mergeSelections"
                class="jp.titze.intellij.helix.editor.HelixMergeSelectionsAction"
                text="Helix Merge Selections"
                description="Merge contiguous or overlapping selections (Alt+_)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift MINUS"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift MINUS"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt shift MINUS"/>
        </action>

        <action id="jp.titze.intellij.helix.rotateSelectionsContentsForward"
                class="jp.titze.intellij.helix.editor.HelixRotateSelectionsContentsForwardAction"
                text="Helix Rotate Selections Contents Forward"
                description="Cycle text contents between multi-carets forward (Alt+))">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift 0"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift 0"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt shift 0"/>
        </action>

        <action id="jp.titze.intellij.helix.rotateSelectionsContentsBackward"
                class="jp.titze.intellij.helix.editor.HelixRotateSelectionsContentsBackwardAction"
                text="Helix Rotate Selections Contents Backward"
                description="Cycle text contents between multi-carets backward (Alt+()">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift 9"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift 9"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt shift 9"/>
        </action>

        <action id="jp.titze.intellij.helix.extendToLineBounds"
                class="jp.titze.intellij.helix.editor.HelixExtendToLineBoundsAction"
                text="Helix Extend to Line Bounds"
                description="Extend selection to whole line bounds (X)">
        </action>

        <action id="jp.titze.intellij.helix.shrinkToLineBounds"
                class="jp.titze.intellij.helix.editor.HelixShrinkToLineBoundsAction"
                text="Helix Shrink to Line Bounds"
                description="Shrink selection to line bounds excluding line breaks (Alt+x)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt X"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt X"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt X"/>
        </action>

        <action id="jp.titze.intellij.helix.repeatLastMotion"
                class="jp.titze.intellij.helix.editor.HelixRepeatLastMotionAction"
                text="Helix Repeat Last Motion"
                description="Repeat last motion (f, t, m, [, ]) (Alt+.)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt PERIOD"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt PERIOD"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt PERIOD"/>
        </action>

        <action id="jp.titze.intellij.helix.deleteNoYank"
                class="jp.titze.intellij.helix.editor.HelixDeleteNoYankAction"
                text="Helix Delete Without Yanking"
                description="Delete selection without yanking (Alt+d)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt D"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt D"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt D"/>
        </action>

        <action id="jp.titze.intellij.helix.changeNoYank"
                class="jp.titze.intellij.helix.editor.HelixChangeNoYankAction"
                text="Helix Change Without Yanking"
                description="Delete selection and enter insert without yanking (Alt+c)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt C"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt C"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt C"/>
        </action>

        <action id="jp.titze.intellij.helix.mergeAllSelections"
                class="jp.titze.intellij.helix.editor.HelixMergeAllSelectionsAction"
                text="Helix Merge All Selections"
                description="Merge all selections into single span (Alt+-)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt MINUS"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt MINUS"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt MINUS"/>
        </action>

        <action id="jp.titze.intellij.helix.joinSelectionsSpace"
                class="jp.titze.intellij.helix.editor.HelixJoinSelectionsSpaceAction"
                text="Helix Join Selections Space"
                description="Join lines and select inserted space (Alt+J)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift J"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift J"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt shift J"/>
        </action>

        <action id="jp.titze.intellij.helix.searchSelectionRaw"
                class="jp.titze.intellij.helix.editor.HelixSearchSelectionRawAction"
                text="Helix Search Selection Raw"
                description="Use current selection as search pattern without word boundaries (Alt+*)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift 8"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift 8"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt shift 8"/>
        </action>

        <action id="jp.titze.intellij.helix.deleteWordBackward"
                class="jp.titze.intellij.helix.editor.HelixDeleteWordBackwardAction"
                text="Helix Delete Word Backward"
                description="Delete previous word backward (Alt+Backspace)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt BACK_SPACE"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt BACK_SPACE"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt BACK_SPACE"/>
        </action>

        <action id="jp.titze.intellij.helix.deleteWordForward"
                class="jp.titze.intellij.helix.editor.HelixDeleteWordForwardAction"
                text="Helix Delete Word Forward"
                description="Delete next word forward (Alt+Delete)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt DELETE"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt DELETE"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt DELETE"/>
        </action>

        <action id="jp.titze.intellij.helix.killToLineEnd"
                class="jp.titze.intellij.helix.editor.HelixKillToLineEndAction"
                text="Helix Kill to Line End"
                description="Delete from cursor to line end (Ctrl+k)">
            <keyboard-shortcut keymap="$default" first-keystroke="control K"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control K"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control K"/>
        </action>

        <action id="jp.titze.intellij.helix.insertRegister"
                class="jp.titze.intellij.helix.editor.HelixInsertRegisterAction"
                text="Helix Insert Register"
                description="Insert contents of register while typing (Ctrl+r)">
            <keyboard-shortcut keymap="$default" first-keystroke="control R"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control R"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control R"/>
        </action>

        <action id="jp.titze.intellij.helix.insertLineEnd"
                class="jp.titze.intellij.helix.editor.HelixInsertLineEndAction"
                text="Helix Insert Move to Line End"
                description="Move cursor to line end in insert mode (Ctrl+e)">
            <keyboard-shortcut keymap="$default" first-keystroke="control E"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control E"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control E"/>
        </action>

        <action id="jp.titze.intellij.helix.insertDeleteCharBackward"
                class="jp.titze.intellij.helix.editor.HelixInsertDeleteCharBackwardAction"
                text="Helix Insert Delete Char Backward"
                description="Delete previous character in insert mode (Ctrl+h)">
            <keyboard-shortcut keymap="$default" first-keystroke="control H"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="control H"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control H"/>
        </action>

        <action id="jp.titze.intellij.helix.shellPipe"
                class="jp.titze.intellij.helix.editor.HelixShellPipeAction"
                text="Helix Shell Pipe"
                description="Pipe selections through shell command and replace with output (|)">
        </action>

        <action id="jp.titze.intellij.helix.shellInsertOutput"
                class="jp.titze.intellij.helix.editor.HelixShellInsertOutputAction"
                text="Helix Shell Insert Output"
                description="Insert output of shell command before selections (!)">
        </action>

        <action id="jp.titze.intellij.helix.shellAppendOutput"
                class="jp.titze.intellij.helix.editor.HelixShellAppendOutputAction"
                text="Helix Shell Append Output"
                description="Append output of shell command after selections (Alt+!)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift 1"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift 1"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt shift 1"/>
        </action>

        <action id="jp.titze.intellij.helix.shellKeepPipe"
                class="jp.titze.intellij.helix.editor.HelixShellKeepPipeAction"
                text="Helix Shell Keep Pipe"
                description="Filter selections by shell command ($)">
        </action>

        <action id="jp.titze.intellij.helix.shellPipeTo"
                class="jp.titze.intellij.helix.editor.HelixShellPipeToAction"
                text="Helix Shell Pipe To"
                description="Pipe selections into shell command ignoring output (Alt+|)">
            <keyboard-shortcut keymap="$default" first-keystroke="alt BACK_SLASH"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt BACK_SLASH"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt BACK_SLASH"/>
        </action>

        <action id="jp.titze.intellij.helix.signatureHelp"
                class="jp.titze.intellij.helix.editor.HelixSignatureHelpAction"
